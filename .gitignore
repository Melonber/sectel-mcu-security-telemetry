# ---- Secrets (never commit) ----
pki/*.key
pki/*.crt
pki/*.srl
firmware/**/main/certs/*.key
firmware/**/main/certs/*.crt
pipeline/.env
**/sdkconfig
**/sdkconfig.old

# ---- ESP-IDF build output ----
firmware/**/build/
firmware/**/managed_components/

# ---- Runtime data ----
backend/events.jsonl
backend/mosquitto-data/
eval/raw/

# ---- Python ----
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# ---- OS / editors ----
.DS_Store
.vscode/
.idea/
*.swp

# ---- Scenario certificates and any private keys ----
scenarios/**/certs/
*.key
*.pem
*.srl

# ---- OTA test images ----
scenarios/**/images/*.bin
 
# ---- Env files anywhere (keep examples) ----
.env
**/.env
!**/.env.example

# ---- Eclipse / Espressif IDE ----
.project
.cproject
.settings/

# ---- Logs ----
*.log

# ---- iCloud / Finder conflict copies ("file 2", "folder 3") ----
* [0-9]
* [0-9].*
