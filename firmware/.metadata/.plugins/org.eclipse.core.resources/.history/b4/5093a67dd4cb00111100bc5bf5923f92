menu "Sectel demo config"

config SECTEL_WIFI_SSID
    string "Wi-Fi SSID (2.4 GHz)"
    default "myssid"

config SECTEL_WIFI_PASSWORD
    string "Wi-Fi password"
    default "mypassword"

config SECTEL_BROKER_URI
    string "MQTT broker URI"
    default "mqtts://192.168.18.207:8883"
    help
        mqtts://<broker ip>:8883. The IP must be in the broker certificate SAN.

config SECTEL_NTP_SERVER
    string "NTP server"
    default "pool.ntp.org"
    help
        In mainland China ntp.aliyun.com or cn.pool.ntp.org may be more reliable.

config SECTEL_TEST_BOOTLOOP
    bool "TEST: boot loop scenario (restart periodically)"
    default n
    help
        Test scenario 01. Never enable in production firmware.

config SECTEL_TEST_BOOTLOOP_DELAY_S
    int "Seconds before each restart"
    depends on SECTEL_TEST_BOOTLOOP
    default 20
    help
        Must exceed Wi-Fi + MQTT connect time, otherwise queued events are lost.

config SECTEL_TEST_BOOTLOOP_PANIC
    bool "Use abort() (crash loop) instead of esp_restart()"
    depends on SECTEL_TEST_BOOTLOOP
    default n

endmenu
